# Bitget USDT-Perpetual API (READ-ONLY).
# Copy this file to `.env` and fill in your real credentials.
# `.env` is gitignored — never commit real keys.
#
# How to generate:
#   https://www.bitget.com/account/newapi
#   Permissions: READ-ONLY (no trade, no withdraw)
#   IP-Whitelist: recommended
#
# Verify with the included sanity check after filling in:
#   python -c "from moritzstrategie.data.bitget_rest import BitgetClient; BitgetClient.from_env().ping()"

BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=

# Default base URL — change only if you know what you're doing
BITGET_BASE_URL=https://api.bitget.com
